SERVER_PORT=8085
API_BASE_PATH=/api/email
# Estate-shared MongoDB connection, supplied by Eco during eco up/configure.
MONGODB_URI=
# Brevo transactional API key (operator-supplied secret on the CT).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Rate limiting knobs (per-recipient daily cap, global hourly budget, and
# warm-up ramp for a freshly verified sending domain).
EMAIL_PER_RECIPIENT_DAY=5
EMAIL_GLOBAL_PER_HOUR=400
EMAIL_WARMUP_MAX_PER_HOUR=400
EMAIL_WARMUP_DAYS=5
